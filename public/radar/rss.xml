    </item>
    <item>
      <title>MetaMask 社交组件：作者评论由后端选择，客户端保留缺失与 null</title>
      <link>https://xiuqiu-site.vercel.app/radar/2026-11-02#web3-metamask-author-comment-authority</link>
      <guid isPermaLink="false">xiuqiu-radar:web3-metamask-author-comment-authority</guid>
