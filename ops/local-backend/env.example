# Copy outside the repository with mode 0600. Never commit real values.
RADAR_LOCAL_BACKEND=true
RADAR_DATABASE_DRIVER=pg
RADAR_LOCAL_DATABASE_URL=postgresql://xiuqiu_radar_app@localhost/xiuqiu_radar?host=%2Fabsolute%2Fpostgres%2Fsocket&port=55432
RADAR_PUBLIC_HMAC_KEYS='{"vercel-preview":"replace-with-at-least-32-random-characters"}'
RADAR_INTERNAL_HMAC_KEYS='{"hermes-local":"replace-with-a-different-32-character-secret"}'
RADAR_INTERNAL_HMAC_KEY_ID=hermes-local
RADAR_INTERNAL_HMAC_SECRET=replace-with-the-same-internal-secret
RADAR_PUBLIC_HOSTNAME=radar-api.example.com
RADAR_NAMED_TUNNEL_ID=replace-with-cloudflare-tunnel-uuid
RADAR_ENABLE_QIU_MARKET=false
RADAR_STATE_DIR=/absolute/local/state
RADAR_LOG_DIR=/absolute/local/logs
RADAR_LOG_MANIFEST=/absolute/local/config/log-manifest.txt
RADAR_CRON_OUTPUT_MANIFEST=/absolute/local/config/cron-output-directories.txt
RADAR_CONTENT_LOG_DIR=/absolute/content/logs/XiuqiuContent
RADAR_HERMES_PRIMARY_LOG_DIR=/absolute/hermes/primary/logs
RADAR_HERMES_SECONDARY_LOG_DIR=/absolute/hermes/secondary/logs
RADAR_NODE_BIN=/absolute/runtime/bin/node
RADAR_NPM_BIN=/absolute/runtime/bin/npm
RADAR_CLOUDFLARED_BIN=/absolute/runtime/bin/cloudflared
RADAR_TUNNEL_CONFIG=/absolute/local/config/cloudflared.yml
RADAR_TUNNEL_CREDENTIALS=/absolute/local/config/tunnel-credentials.json
CONTENT_POSTGRES_SOCKET_DIR=/absolute/content/postgres/socket
RADAR_HERMES_PRIMARY_HOME=/absolute/hermes/primary
RADAR_HERMES_SECONDARY_HOME=/absolute/hermes/secondary
ARTICLE_CATALOG_HMAC_KEYS_JSON='{"content-status":"replace-with-existing-content-health-secret"}'
CONTENT_API_LAUNCHD_LABEL=com.xiuqiu.content.api
CONTENT_POSTGRES_LAUNCHD_LABEL=com.xiuqiu.content.postgres
RADAR_HERMES_PRIMARY_LAUNCHD_LABEL=ai.hermes.gateway
RADAR_HERMES_SECONDARY_LAUNCHD_LABEL=ai.hermes.gateway-radar-secondary
