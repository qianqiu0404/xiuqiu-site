{
  "name": "xiuqiu-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run generate:content && vite",
    "build": "npm run test:release && npm run test:content && npm run test:content-preview && npm run test:radar && npm run test:market-radar && npm run test:notifications && npm run generate:content && npm run test:home && npm run test:ai && npm run test:assistant && npm run test:chat && npm run generate:sitemap && npm run check:knowledge && npm run check:public && npm run typecheck:api && vue-tsc && vite build && npm run generate:meta-pages && npm run test:quality && npm run check:budget",
    "build:vite": "vue-tsc && vite build",
    "generate:content": "npm run generate:articles && npm run generate:projects && npm run generate:ai && npm run generate:learning && npm run generate:radar && npm run generate:market-radar && npm run generate:radar-weekly && npm run generate:failures && npm run generate:evidence && npm run generate:deliveries && npm run generate:now",
    "generate:articles": "node scripts/generate-articles.mjs",
    "generate:projects": "node scripts/generate-projects.mjs",
    "generate:ai": "node scripts/generate-ai-cases.mjs",
    "generate:learning": "node scripts/generate-learning.mjs",
    "generate:radar": "node scripts/generate-radars.mjs",
    "generate:market-radar": "node scripts/generate-market-radars.mjs",
    "generate:radar-weekly": "node scripts/generate-radar-weeklies.mjs",
    "generate:failures": "node scripts/generate-failure-cases.mjs",
    "generate:evidence": "node scripts/generate-evidence.mjs",
    "generate:deliveries": "node scripts/generate-deliveries.mjs",
    "generate:now": "node scripts/generate-now.mjs",
    "extract:radar": "node scripts/extract-radar-source.mjs",
    "test:content": "node --test scripts/public-data-contracts.test.mjs",
    "test:chat": "node --test scripts/chat-api.test.mjs",
    "test:home": "node --test scripts/home-presentation.test.mjs",
    "test:ai": "node --test scripts/ai-evidence-presentation.test.mjs",
    "test:assistant": "node --test scripts/ai-assistant.test.mjs",
    "test:radar": "node --test scripts/radar-pipeline.test.mjs scripts/radar-presentation.test.mjs scripts/researchops-ledger.test.mjs scripts/daily-radar-workflow.test.mjs",
    "test:market-radar": "node --test scripts/market-radar.test.mjs scripts/market-radar-worker.test.mjs scripts/market-radar-event-contract.test.mjs scripts/dual-timeline-contract.test.mjs scripts/static-market-radar-workflow.test.mjs",
    "test:radar-db": "RUN_RADAR_DB_TESTS=true node --test --test-name-pattern='real PostgreSQL' scripts/dual-timeline-contract.test.mjs",
    "test:notifications": "node --test scripts/radar-notifications.test.mjs",
    "test:release": "node --test scripts/release-workflow.test.mjs",
    "test:article-shadow": "node --test scripts/article-catalog-shadow.test.mjs",
    "test:content-preview": "node --test scripts/content-catalog-preview.test.mjs",
    "test:quality": "node --test scripts/site-quality.test.mjs",
    "validate:radar": "node scripts/validate-radar-candidate.mjs",
    "prepare:researchops": "node scripts/prepare-researchops-source.mjs",
    "sync:learning": "node scripts/sync-learning-from-obsidian.mjs",
    "sync:obsidian-public": "node scripts/export-public-obsidian.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "generate:meta-pages": "node scripts/generate-meta-pages.mjs",
    "check:knowledge": "node scripts/validate-knowledge.mjs",
    "check:public": "node scripts/check-public.mjs",
    "check:links": "node scripts/check-portfolio-links.mjs",
    "check:budget": "node scripts/check-build-budget.mjs",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "article-shadow:migrate": "node article-catalog-shadow/migrate.mjs",
    "article-shadow:import": "node article-catalog-shadow/import-articles.mjs",
    "article-shadow:serve": "node article-catalog-shadow/server.mjs",
    "market-radar:migrate": "node market-radar/worker/migrate.mjs",
    "market-radar:worker": "node market-radar/worker/run.mjs",
    "notifications:enqueue": "node scripts/enqueue-radar-notifications.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "pg": "^8.16.3",
    "typescript": "~5.7.3",
    "vite": "^6.4.3",
    "vue-tsc": "^3.3.8",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "nanoid": "3.3.17",
    "postcss": "^8.5.23"
  }
}
