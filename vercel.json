{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/research-data/:path*",
      "destination": "https://shared-research.vercel.app/feed/v1/:path*"
    }
  ],
  "functions": {
    "api/chat.ts": {
      "includeFiles": "src/data/**"
    }
  }
}
