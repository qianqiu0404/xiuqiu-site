{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/internal/market-snapshots", "destination": "/api/%5B...m2%5D" },
    { "source": "/api/market-radar/market-status", "destination": "/api/%5B...m2%5D" },
    { "source": "/api/private-market/auth/github/login", "destination": "/api/%5B...m2%5D" },
    { "source": "/api/private-market/auth/github/callback", "destination": "/api/%5B...m2%5D" },
    { "source": "/api/private-market/snapshot", "destination": "/api/%5B...m2%5D" },
    { "source": "/api/private-market/logout", "destination": "/api/%5B...m2%5D" }
  ],
  "headers": [
    {
      "source": "/content-catalog-preview",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/private/market",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/api/private-market/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/api/internal/market-snapshots",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ],
  "functions": {
    "api/chat.ts": {
      "includeFiles": "src/data/**"
    }
  }
}
