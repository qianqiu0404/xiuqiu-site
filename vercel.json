{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/actions-demo",
      "destination": "/actions-demo/index.html",
      "permanent": false
    },
    {
      "source": "/answer-check-demo",
      "destination": "/answer-check-demo/index.html",
      "permanent": false
    },
    {
      "source": "/memory-demo",
      "destination": "/memory-demo/index.html",
      "permanent": false
    },
    {
      "source": "/mini-exchange-demo",
      "destination": "/mini-exchange-demo/index.html",
      "permanent": false
    },
    {
      "source": "/retrieval-demo",
      "destination": "/retrieval-demo/index.html",
      "permanent": false
    },
    {
      "source": "/watch-demo",
      "destination": "/watch-demo/index.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/grok-news-data/:path*",
      "destination": "https://raw.githubusercontent.com/qianqiu0404/xiuqiu-site/refs/heads/news/x-ai-digest/feed/v1/:path*"
    },
    {
      "source": "/chatgpt-news-data/:path*",
      "destination": "https://raw.githubusercontent.com/qianqiu0404/xiuqiu-site/refs/heads/news/chatgpt-daily/feed/v1/:path*"
    },
    {
      "source": "/research-data/:path*",
      "destination": "https://shared-research.vercel.app/feed/v1/:path*"
    }
  ],
  "functions": {
    "api/chat.ts": {
      "includeFiles": "src/data/**"
    }
  }
}
